POSTGRES_USER=casadana
POSTGRES_PASSWORD=changeme
POSTGRES_DB=casadana
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# API
PORT=8080
COOKIE_SECURE=true

JWT_SECRET=changeme

RESEND_API_KEY=re_changeme

# Sender address for transactional mail sent via Resend. Must be on a domain
# verified in Resend, or sends fail at runtime rather than at boot.
MAIL_FROM=no-reply@casa-dana.com

# Where new-booking notifications go.
ADMIN_NOTIFY_EMAIL=owner@casa-dana.com

# Comma-separated CORS allow-list. Must match the public origin exactly,
# scheme included. The API refuses to start if this is unset.
#   local: http://localhost:5173
#   demo:  https://demo.casa-dana.com
#   prod:  https://casa-dana.com
WEB_ORIGIN=http://localhost:5173

# Optional, shown with their defaults:
# LOG_LEVEL=info
# MIGRATE_ON_BOOT=true   # applies the embedded migrations at startup
